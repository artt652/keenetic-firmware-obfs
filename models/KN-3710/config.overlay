# Kconfig values for KN-3710 (Sprinter) to enable the internal OPKG storage.
# Based on KN-3810 (Hopper, same EN7528 platform) in keenetic-sdk 5.01 and
# github.com/srgsf/keenetic-sdk branch KN-3710-storage.
CONFIG_USES_EXTENDED_STORAGE=y
CONFIG_KERNEL_MTD_NDM_EXTENDED_STORAGE=y
CONFIG_KERNEL_EFI_PARTITION=y
CONFIG_KERNEL_MAC_PARTITION=y
CONFIG_KERNEL_MSDOS_PARTITION=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-md4=m
CONFIG_PACKAGE_kmod-crypto-zstd=y
CONFIG_PACKAGE_kmod-fs-ubi=y
CONFIG_PACKAGE_kmod-fs-ubifs=y
CONFIG_PACKAGE_kmod-lib-crc-itu-t=m
CONFIG_PACKAGE_kmod-lib-crc16=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-ndm-storage=y
CONFIG_PACKAGE_libext2fs=m
CONFIG_PACKAGE_libxml2=y
CONFIG_PACKAGE_ndm-mod-fstools=m
CONFIG_PACKAGE_ndm-mod-opkg-kmod-fs=m
CONFIG_PACKAGE_ndm-mod-storage=y
CONFIG_PACKAGE_openssh-sftp-server=m
CONFIG_PACKAGE_dosfstools=m
CONFIG_PACKAGE_e2fsprogs=m
CONFIG_PACKAGE_exfat-fsck=m
CONFIG_PACKAGE_exfat-mkfs=m
CONFIG_PACKAGE_tntfs-utils=m
CONFIG_PACKAGE_liblzo=y
